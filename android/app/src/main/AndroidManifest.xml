<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback sockets and, when the user asks for it, the Drive backup upload.
         Nothing else leaves the device. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.OpenLedger"
        tools:ignore="UnusedAttribute">

        <!--
          extractNativeLibs above is required, not cosmetic. The PHP interpreter ships as
          libphp.so so that it lands in the extracted native library directory, which since
          Android 10 is the only place an app may execute a binary from. Leave this false and
          the library stays compressed inside the APK and cannot be exec'd.

          allowBackup is false, and network_security_config.xml keeps cleartext off everywhere
          except 127.0.0.1 — which never leaves the device.
        -->

        <!-- Answers the watch over Bluetooth. Bound by Google Play services, not by us, which
             is why it is exported; the Data Layer only routes between apps sharing this
             package name and signing key, so nothing else on the phone can reach it. -->
        <service
            android:name=".LedgerWearService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ledger" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
