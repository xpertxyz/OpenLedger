<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      What the watch looks for when it is set to read this phone's ledger. Declared rather than
      assumed: a watch may be paired to more than one phone over its life, and only the one
      actually running this app should be asked for a ledger. PhoneBackend queries it by name.
    -->
    <string-array name="android_wear_capabilities">
        <item>open_ledger_phone</item>
    </string-array>
</resources>
