# Hostinger / Apache / LiteSpeed front-controller
RewriteEngine On

# Directories that ship in this repo but must never be served. This has to come BEFORE the
# "serve real files" rule below, which ends with [L] and would otherwise hand them straight out.
#
# Deployment is `git pull` onto the web root, so everything committed lands here whether the
# website wants it or not:
#
#   android/  the phone app. It lives in this repo deliberately — its Gradle build copies
#             index.php/lib.php/views.php out of this directory, which is what stops the phone
#             and the website from drifting apart — but nothing in it belongs on the web.
#   tests/    dual-driver.php is a CLI harness. Served over HTTP it would EXECUTE: connect to
#             the database, write rows inside a transaction, and print the driver and schema
#             to an unauthenticated caller. Rolled back, but not anyone's business.
#
# docs/ is deliberately NOT in this list. It is the handoff and deploy documentation for an
# open-source app and is meant to be readable by anyone, on the site as well as in the repo.
RewriteRule ^(android|tests)/ - [F,L]

# Serve real files (styles.css, favicon, etc.) as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else -> index.php
RewriteRule ^ index.php [L]

# Belt & braces: block direct fetches of app internals (all still `require`-able from PHP).
<FilesMatch "^(config\.php|views\.php|lib\.php|router\.php|CLAUDE\.md|README\.md|Home\ Expense\ Tracker\.dc\.html)$">
    Require all denied
</FilesMatch>

# Deny any dotfile fetch (.env, .git*, .htaccess itself, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Apache doesn't know .webmanifest by default; without this it is served as text/plain
# and some browsers ignore the manifest entirely.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Basic hardening headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "same-origin"
</IfModule>

# Every page carries its stylesheet and icon sprite inline — about 30 KB of highly repetitive
# CSS and SVG that compresses to roughly a fifth of that. Without this the host's default
# decides, and the default is not guaranteed to be on.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# Static assets only. HTML is deliberately absent: pages are per-user and per-session, and a
# cached one would show the wrong household's numbers after a ledger switch.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>
