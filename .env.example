# Open Ledger — environment. Copy to `.env` and fill in real values.
# .env is read at startup by config.php. Host env vars (if set) take precedence.

# ── Database driver: `mysql` (web) or `sqlite` (Android / local single-file).
# Leave as mysql on the server — the SQLite path exists for the Android build.
DB_DRIVER=mysql

# ── MySQL (from Hostinger cPanel → Databases → MySQL Databases)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ── SQLite (only read when DB_DRIVER=sqlite). Defaults to data/ledger.db.
#DB_PATH=/absolute/path/to/ledger.db

# ── Timezone for every date the app computes. Was implicitly UTC before, which
# filed a 1am expense under the previous day. Set it to the household's zone.
APP_TZ=Asia/Kolkata

# ── Feature switches. Both default to 1 (on) — the Android build sets them to 0.
#HL_SHARING=1
#HL_GOOGLE_SIGNIN=1
#HL_TERMS_URL=

# ── Debug (dev / troubleshooting only — never leave on in production)
APP_DEBUG=0

# ── Google Identity Services
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Add your Hostinger URL to "Authorised JavaScript origins" — e.g. https://yourdomain.com
# (public value — safe to include in HTML; no client secret is used)
GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
